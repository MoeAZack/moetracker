# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://moetracker.web.app"

# Required secrets. Generate unique values; production refuses to start without them.
# Example: openssl rand -base64 48
ADMIN_PASSWORD=""
JWT_SECRET=""
HENRIK_API_KEY=""
GRID_API_KEY=""
DISCORD_WEBHOOK_URL=""

# Optional private replay parser. Uploads never parse until these absolute paths are configured.
# Accepted binary: vrfkit v0.2.5, executable SHA-256 below. See docs/VRFKIT-REPLAY-PARSER.md.
VRFKIT_BINARY_PATH=""
VRFKIT_BINARY_SHA256="aa55fc410f1596a6ffedc7ab579341da6edb262197c64902e74b4eed485dc23f"
VRFKIT_PYTHON_PATH=""
# VRFKIT_JOBS_DIR must remain a private child of REPLAY_STORAGE_DIR.
VRFKIT_JOBS_DIR=""
VRFKIT_PARSE_TIMEOUT_MS="300000"
VRFKIT_MAX_OUTPUT_BYTES="805306368"
VRFKIT_MAX_OUTPUT_FILES="32"
