# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="https://moetracker.web.app"

# Required secrets. Generate unique values; production refuses to start without them.
# Example: openssl rand -base64 48
ADMIN_PASSWORD=""
JWT_SECRET=""
HENRIK_API_KEY=""

# Firestore uses an empty structural seed on first boot. Enable JSON import only
# for an explicit, validated migration from DB_PATH.
FIRESTORE_IMPORT_JSON_ON_FIRST_BOOT="false"
GRID_API_KEY=""
DISCORD_WEBHOOK_URL=""

# Optional private replay parser. Uploads never parse until these absolute paths are configured.
# Accepted binary: vrfkit v0.2.5, executable SHA-256 below. See docs/VRFKIT-REPLAY-PARSER.md.
VRFKIT_BINARY_PATH=""
VRFKIT_BINARY_SHA256="aa55fc410f1596a6ffedc7ab579341da6edb262197c64902e74b4eed485dc23f"
VRFKIT_PYTHON_PATH=""
# VRFKIT_JOBS_DIR must remain a private child of REPLAY_STORAGE_DIR.
VRFKIT_JOBS_DIR=""
VRFKIT_PARSE_TIMEOUT_MS="300000"
VRFKIT_MAX_OUTPUT_BYTES="805306368"
VRFKIT_MAX_OUTPUT_FILES="32"
VRFKIT_MAX_CONCURRENT_JOBS="1"
VRFKIT_MAX_QUEUED_JOBS="8"
VRFKIT_MAX_ACTOR_ACTIVE_JOBS="2"
VRFKIT_MAX_DEVICE_ACTIVE_JOBS="2"
VRFKIT_RETAINED_JOB_COUNT="100"
VRFKIT_JOB_RETENTION_MS="2592000000"
VRFKIT_MAX_RETAINED_EVIDENCE_BYTES="4194304"
# Optional coach-only raw fallback. Keep disabled until the dedicated Standard regional
# temp bucket, least-privilege IAM, versioning-off, soft-delete-off, and age-1 lifecycle are verified.
REPLAY_RAW_GCS_ENABLED="false"
REPLAY_RAW_GCS_BUCKET=""
REPLAY_RAW_SESSION_TTL_MINUTES="30"
# Temporary migration escape hatch only. Production default rejects server-proxied
# replay bytes, and even when enabled this route accepts coach-owned devices only.
REPLAY_LEGACY_RAW_UPLOAD_ENABLED="false"
